{
  "redirects": [
    {
      "source": "/project/:slug*",
      "destination": "/:slug*",
      "permanent": true
    },
    {
      "source": "/talent/:slug*",
      "destination": "/:slug*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/audiont",
      "destination": "/audiont.html"
    },
    {
      "source": "/venado-tuerto-el-musical",
      "destination": "/venado-tuerto-el-musical.html"
    },
    {
      "source": "/tv",
      "destination": "/tv.html"
    },
    {
      "source": "/turing",
      "destination": "/turing.html"
    },
    {
      "source": "/turing-admin",
      "destination": "/turing-admin.html"
    },
    {
      "source": "/:slug([a-z0-9][a-z0-9-]*)",
      "destination": "/plantform.html"
    }
  ]
}