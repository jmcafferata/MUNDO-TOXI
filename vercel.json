{
  "functions": {
    "api/transcribe.mjs": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "toxi.media"
        }
      ],
      "destination": "https://www.toxi.media/$1",
      "permanent": true
    },
    {
      "source": "/project/:slug*",
      "destination": "/:slug*",
      "permanent": true
    },
    {
      "source": "/talent/:slug*",
      "destination": "/:slug*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/moneda/:id",
      "destination": "/api/moneda?id=:id"
    },
    {
      "source": "/moneda",
      "destination": "/api/moneda"
    },
    {
      "source": "/m/:id",
      "destination": "/api/m?id=:id"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/trabajos",
      "destination": "/trabajos.html"
    },
    {
      "source": "/store",
      "destination": "/store.html"
    },
    {
      "source": "/audiont",
      "destination": "/audiont.html"
    },
    {
      "source": "/venado-tuerto-el-musical",
      "destination": "/venado-tuerto-el-musical.html"
    },
    {
      "source": "/nota-constante",
      "destination": "/nota-constante.html"
    },
    {
      "source": "/otro-dia-en-la-red",
      "destination": "/otro-dia-en-la-red.html"
    },
    {
      "source": "/xplora-night-live",
      "destination": "/xplora-night-live.html"
    },
    {
      "source": "/ariana-grande",
      "destination": "/ariana-grande/index.html"
    },
    {
      "source": "/mers-vlog",
      "destination": "/mers-vlog.html"
    },
    {
      "source": "/mers-vlog-cast",
      "destination": "/mers-vlog-cast.html"
    },
    {
      "source": "/xplora-night-live/overlay-countdown",
      "destination": "/xplora-night-live-overlay-countdown.html"
    },
    {
      "source": "/wiki",
      "destination": "/wiki.html"
    },
    {
      "source": "/onboarding",
      "destination": "/onboarding.html"
    },
    {
      "source": "/matriz",
      "destination": "/matriz.html"
