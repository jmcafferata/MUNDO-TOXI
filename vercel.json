{
  "redirects": [
    {
      "source": "/project/:slug*",
      "destination": "/:slug*",
      "permanent": true
    },
    {
      "source": "/talent/:slug*",
      "destination": "/:slug*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:slug([a-z0-9][a-z0-9-]*)",
      "destination": "/plantform.html"
    }
  ]
}